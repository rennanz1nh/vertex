{
  "manifest_version": 3,
  "name": "Vertex · Sync Turo",
  "version": "1.2.0",
  "description": "Envia as viagens, ganhos e recibos da Turo para o admin da Vertex, sozinho, a cada hora.",
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "scripting", "tabs", "notifications", "idle"],
  "host_permissions": ["https://turo.com/*", "https://vertexrentalcar.com/*", "https://www.vertexrentalcar.com/*"]
}
